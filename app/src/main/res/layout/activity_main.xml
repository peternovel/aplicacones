<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="LEVANTAMIENTO"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obtener ubicación actual" />

        <EditText
            android:id="@+id/txtCoordenadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordenadas"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/txtDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección"
            android:inputType="textPostalAddress"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de lámpara"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spTipoLampara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de poste"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spTipoPoste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/txtEquipoInstalado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Equipo instalado"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/txtTipoBanco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo de banco"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/txtCapacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Capacidad"
            android:inputType="text"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Guardar datos" />

    </LinearLayout>
</ScrollView>
